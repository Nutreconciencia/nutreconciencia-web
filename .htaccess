# BEGIN NUTRECONCIENCIA CANONICAL URL RULES
RewriteEngine On

# 1. Root and section index.html -> canonical trailing-slash URL
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ / [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+articulos/index\.html(?:[?\s]) [NC]
RewriteRule ^articulos/index\.html$ /articulos/ [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+prensa/index\.html(?:[?\s]) [NC]
